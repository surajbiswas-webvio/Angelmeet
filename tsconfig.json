{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["config/**/*.ts", "fixtures/**/*.ts", "helpers/**/*.ts", "locators/**/*.ts", "pages/**/*.ts", "tests/**/*.ts", "utilities/**/*.ts", "playwright.config.ts"]
}
