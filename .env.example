# Copy this file to `.env` and replace the placeholder values with real credentials.

# Base URL of the user application.
BASE_URL=https://app.angelmeet.ai
# Test account credentials for the user application.
E2E_EMAIL=replace-with-test-account-email
E2E_PASSWORD=replace-with-test-account-password

# Base URL of the admin control plane.
ADMIN_URL=https://admin.angelmeet.ai
# Admin account credentials for the admin control plane.
ADMIN_EMAIL=replace-with-admin-email
ADMIN_PASSWORD=replace-with-admin-password
